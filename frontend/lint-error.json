mn":19},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadAudit'. Either include it or remove the dependency array.","line":108,"column":6,"nodeType":"ArrayExpression","endLine":108,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [loadAudit]","fix":{"range":[2960,2962],"text":"[loadAudit]"}}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":234,"column":43,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":234,"endColumn":46,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6070,6073],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6070,6073],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useCallback, useEffect, useMemo, useState, type FormEvent } from \"react\";\n\nimport { Loader2, Pencil, Plus, Trash2 } from \"lucide-react\";\n\nimport { useModuleActions } from \"@/hooks/useModuleActions\";\nimport { useDebouncedValue } from \"@/hooks/useDebouncedValue\";\n\nimport CrudDrawer from \"@/components/crud/CrudDrawer\";\nimport CrudPagination from \"@/components/crud/CrudPagination\";\nimport CrudToolbar from \"@/components/crud/CrudToolbar\";\nimport CrudTextField from \"@/components/crud/fields/CrudTextField\";\nimport CrudTextAreaField from \"@/components/crud/fields/CrudTextAreaField\";\nimport CrudSelectField from \"@/components/crud/fields/CrudSelectField\";\n\nimport {\n  listGeneralDiscussions,\n  createGeneralDiscussion,\n  updateGeneralDiscussion,\n} from \"@/services/generalDiscussion\";\n\ntype StatusFilter = \"all\" | \"active\" | \"inactive\";\n\ntype GeneralDiscussion = {\n  id: number;\n  audit_id: number;\n  title: string;\n  description: string | null;\n  status: string;\n  is_active: boolean;\n  created_at: string;\n};\n\ntype AuditOption = {\n  id: number;\n  name: string;\n};\n\nconst initialForm = {\n  audit_id: \"\",\n  title: \"\",\n  description: \"\",\n  status: \"active\",\n};\n\nexport default function GeneralDiscussionPage() {\n  const actions = useModuleActions(\"general_discussion\");\n\n  const [items, setItems] = useState<GeneralDiscussion[]>([]);\n  const [auditOptions, setAuditOptions] = useState<AuditOption[]>([]);\n\n  const [page, setPage] = useState(1);\n  const [pageSize, setPageSize] = useState(10);\n  const [total, setTotal] = useState(0);\n\n  const [search, setSearch] = useState(\"\");\n  const [statusFilter, setStatusFilter] = useState<StatusFilter>(\"all\");\n\n  const [loading, setLoading] = useState(false);\n\n  const [drawerOpen, setDrawerOpen] = useState(false);\n  const [drawerMode, setDrawerMode] = useState<\"create\" | \"edit\">(\"create\");\n  const [selectedItem, setSelectedItem] = useState<GeneralDiscussion | null>(null);\n\n  const [form, setForm] = useState(initialForm);\n\n  const debouncedSearch = useDebouncedValue(search, 400);\n\n  const numericPageSize = pageSize === \"all\" ? 100 : Number(pageSize);\n\n  const loadData = useCallback(async () => {\n    setLoading(true);\n\n    try {\n      const res = await listGeneralDiscussions({\n        page,\n        pageSize: numericPageSize,\n        search: debouncedSearch,\n        isActive:\n          statusFilter === \"all\"\n            ? undefined\n            : statusFilter === \"active\",\n      });\n\n      setItems(res.items);\n      setTotal(res.total);\n    } finally {\n      setLoading(false);\n    }\n  }, [page, numericPageSize, debouncedSearch, statusFilter]);\n\n  const loadAudit = useCallback(async () => {\n    const res = await listAuditMasters();\n    setAuditOptions(res as AuditOption[]);\n  }, []);\n\n  useEffect(() => {\n    const timer = setTimeout(() => {\n      void loadData();\n    }, 0);\n\n    return () => clearTimeout(timer);\n  }, [loadData]);\n\n  useEffect(() => {\n    void loadAudit();\n  }, []);\n\n  const openCreate = () => {\n    setDrawerMode(\"create\");\n    setSelectedItem(null);\n    setForm(initialForm);\n    setDrawerOpen(true);\n  };\n\n  const openEdit = (item: GeneralDiscussion) => {\n    setDrawerMode(\"edit\");\n    setSelectedItem(item);\n\n    setForm({\n      audit_id: String(item.audit_id),\n      title: item.title,\n      description: item.description || \"\",\n      status: item.status,\n    });\n\n    setDrawerOpen(true);\n  };\n\n  const handleSubmit = async (e: FormEvent<HTMLFormElement>) => {\n    e.preventDefault();\n\n    const payload = {\n      audit_id: Number(form.audit_id),\n      title: form.title,\n      description: form.description,\n      status: form.status,\n    };\n\n    if (drawerMode === \"create\") {\n      await createGeneralDiscussion(payload);\n    } else if (selectedItem) {\n      await updateGeneralDiscussion(selectedItem.id, payload);\n    }\n\n    setDrawerOpen(false);\n    setSelectedItem(null);\n    setForm(initialForm);\n\n    await loadData();\n  };\n\n  return (\n    <div className=\"space-y-6\">\n\n      <div className=\"flex justify-between\">\n        <h1 className=\"text-xl font-bold\">General Discussions</h1>\n\n        {actions.canCreate && (\n          <button\n            onClick={openCreate}\n            className=\"bg-black text-white px-4 py-2 rounded\"\n          >\n            <Plus size={16} /> Add\n          </button>\n        )}\n      </div>\n\n      <CrudToolbar\n        pageSize={pageSize}\n        onPageSizeChange={setPageSize}\n        onRefresh={loadData}\n        onReset={() => {\n          setSearch(\"\");\n          setStatusFilter(\"all\");\n        }}\n        filters={[\n          {\n            key: \"search\",\n            label: \"Search\",\n            type: \"search\",\n            value: search,\n            onChange: setSearch,\n          },\n        ]}\n      />\n\n      {loading ? (\n        <Loader2 className=\"animate-spin\" />\n      ) : (\n        <div className=\"space-y-2\">\n          {items.map((item) => (\n            <div key={item.id} className=\"border p-3 rounded flex justify-between\">\n              <div>\n                <div className=\"font-bold\">{item.title}</div>\n                <div className=\"text-sm text-gray-500\">\n                  {item.description}\n                </div>\n              </div>\n\n              <div className=\"flex gap-2\">\n                <button onClick={() => openEdit(item)}>\n                  <Pencil size={16} />\n                </button>\n\n                <button>\n                  <Trash2 size={16} />\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      <CrudPagination\n        page={page}\n        totalPages={Math.max(1, Math.ceil(total / numericPageSize))}\n        total={total}\n        pageSize={numericPageSize}\n        onPageChange={setPage}\n      />\n\n      <CrudDrawer\n        isOpen={drawerOpen}\n        onClose={() => setDrawerOpen(false)}\n        title=\"General Discussion\"\n      >\n        <form onSubmit={handleSubmit} className=\"space-y-3\">\n\n          <CrudSelectField\n            label=\"Audit\"\n            value={form.audit_id}\n            options={auditOptions.map((a: any) => ({\n              value: String(a.id),\n              label: a.name,\n            }))}\n            onChange={(v) => setForm({ ...form, audit_id: v })}\n          />\n\n          <CrudTextField\n            label=\"Title\"\n            value={form.title}\n            onChange={(v) => setForm({ ...form, title: v })}\n          />\n\n          <CrudTextAreaField\n            label=\"Description\"\n            value={form.description}\n            onChange={(v) => setForm({ ...form, description: v })}\n          />\n\n          <button className=\"bg-black text-white px-4 py-2 rounded\">\n            Save\n          </button>\n        </form>\n      </CrudDrawer>\n\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"E:\\Audit\\AMS\\frontend\\src\\app\\(protected)\\layout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\Audit\\AMS\\frontend\\src\\app\\(protected)\\security\\menu-action-permissions\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\Audit\\AMS\\frontend\\src\\app\\(protected)\\security\\menu-permissions\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\Audit\\AMS\\frontend\\src\\app\\(protected)\\security\\menus\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\Audit\\AMS\\frontend\\src\\app\\(protected)\\security\\permissions\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\Audit\\AMS\\frontend\\src\\app\\(protected)\\security\\role-permissions\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"E:\\Audit\\AMS\\frontend\\src\\app\\(protected)\\security\\roles\\page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableError