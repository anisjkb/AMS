from sqlalchemy.orm import Session
from app.models.general_discussion import GeneralDiscussion
from app.repositories.general_discussion_repository import GeneralDiscussionRepository


class GeneralDiscussionService:

    def __init__(self):
        self.repo = GeneralDiscussionRepository()

    def create(self, db: Session, data):
        obj = GeneralDiscussion(**data.dict())
        return self.repo.create(db, obj)

    def get(self, db: Session, id: int):
        return self.repo.get_by_id(db, id)

    def list(self, db: Session):
        return self.repo.list(db)

    def update(self, db: Session, obj, data):
        for key, value in data.dict(exclude_unset=True).items():
            setattr(obj, key, value)
        return self.repo.update(db, obj)

    def delete(self, db: Session, obj):
        return self.repo.delete(db, obj)
