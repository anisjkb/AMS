from sqlalchemy.orm import Session
from app.models.general_discussion import GeneralDiscussion


class GeneralDiscussionRepository:

    def create(self, db: Session, obj: GeneralDiscussion):
        db.add(obj)
        db.commit()
        db.refresh(obj)
        return obj

    def get_by_id(self, db: Session, id: int):
        return db.query(GeneralDiscussion).filter(GeneralDiscussion.id == id).first()

    def list(self, db: Session):
        return db.query(GeneralDiscussion).all()

    def update(self, db: Session, obj: GeneralDiscussion):
        db.commit()
        db.refresh(obj)
        return obj

    def delete(self, db: Session, obj: GeneralDiscussion):
        db.delete(obj)
        db.commit()
